{
  "name": "floraria-frontend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "predev": "node copy-data.mjs",
    "dev": "vite",
    "prebuild": "node copy-data.mjs",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:browser": "node verify-atlas.mjs",
    "check": "tsc --noEmit",
    "format": "prettier --write src *.mjs index.html vite.config.ts package.json",
    "format:check": "prettier --check src *.mjs index.html vite.config.ts package.json"
  },
  "dependencies": {
    "@fasl-work/caos-app-shell": "0.6.2",
    "katex": "0.16.33",
    "lucide-react": "0.577.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-router": "7.18.3",
    "three": "0.185.1",
    "zustand": "5.0.11"
  },
  "devDependencies": {
    "@playwright/test": "1.58.2",
    "@types/node": "22.20.0",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@types/three": "0.183.1",
    "@vitejs/plugin-react": "4.7.0",
    "prettier": "3.6.2",
    "typescript": "5.9.3",
    "vite": "6.4.3",
    "vitest": "3.2.6"
  },
  "engines": {
    "node": ">=22 <25"
  }
}
