# Reproducible local environments, caches and generated builds.
.venv/
.venv*/
venv/
__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/
build/
dist/
node_modules/
frontend/dist/
frontend/.vite/
frontend/public/data/
frontend/public/manifests/
frontend/public/draco/
frontend/public/release.json
*.tsbuildinfo
playwright-report/
test-results/

# Operator values and downloaded source caches are never committed.
.env
.env.*
!.env.example
data/raw/
*.key
*.pem
*.p12

# Local logs and operating-system files.
*.log
.DS_Store
Thumbs.db
