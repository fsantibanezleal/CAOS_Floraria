{
  "// note": "FLORARIA uses plain Python data scripts and a repository-local environment; generated assets and dependencies stay outside editor analysis.",
  "python.defaultInterpreterPath": "${workspaceFolder}/.venv/Scripts/python.exe",
  "python.analysis.extraPaths": ["data-pipeline"],
  "python.analysis.exclude": ["**/.venv*/**", "**/node_modules/**", "**/frontend/dist/**"],
  "files.watcherExclude": {
    "**/.venv*/**": true,
    "**/node_modules/**": true,
    "**/frontend/dist/**": true,
    "**/frontend/public/data/**": true,
    "**/__pycache__/**": true,
    "**/data/raw/**": true
  },
  "search.exclude": {
    "**/.venv*": true,
    "**/node_modules": true,
    "**/frontend/dist": true
  }
}
