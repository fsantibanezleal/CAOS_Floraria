# Floraria runs entirely in the browser. No visitor account or runtime secret is required.
# Setup copies this file to .env only if .env does not already exist.

# Optional public hostname used by operator deployment commands.
FLORARIA_DOMAIN=floraria.fasl-work.com

# Required only for operator deployment or rollback. Set these in the caller's environment.
# Scripts do not load private values from a repository file or store SSH key material.
# FLORARIA_SSH_TARGET=operator@host
# FLORARIA_SSH_KEY=/absolute/path/to/operator-managed-identity
